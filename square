import React, { useState, useRef, useEffect } from 'react';
import { Sparkles, Brain, Eye, EyeOff, RotateCcw, PenTool, Type, Eraser, Check, Watch, Smartphone, Link, Link2Off } from 'lucide-react';
import { initializeApp } from "firebase/app";
import { getAuth, signInAnonymously, onAuthStateChanged, signInWithCustomToken } from "firebase/auth";
import { getFirestore, doc, setDoc, onSnapshot } from "firebase/firestore";

// --- Firebase 安全初始化 ---
let app, auth, db, appId = 'default-magic-app';
try {
  appId = typeof __app_id !== 'undefined' ? __app_id : 'default-magic-app';
  const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;
  if (firebaseConfig) {
    app = initializeApp(firebaseConfig);
    auth = getAuth(app);
    db = getFirestore(app);
  }
} catch (e) {
  console.error("Firebase 初始化失敗:", e);
}

// --- 通用的畫布格子元件 ---
const DrawCell = ({ 
  index, mode, cellData, updateCell, calcVal, 
  isRevealed, isGrey, seqNumber, isPeekerEnabled, peekContent,
  showLocalHint, // 新增：是否在本機畫板上顯示小抄
  onPeekStateChange,
  containerClass = "aspect-square",
  textClass = "text-3xl sm:text-4xl"
}) => {
  const cellRef = useRef(null);
  const [isDrawing, setIsDrawing] = useState(false);
  const [isPeekingNow, setIsPeekingNow] = useState(false);
  const pressTimer = useRef(null);

  useEffect(() => {
    return () => cancelPeek();
  }, []);

  const triggerPeek = () => {
    setIsPeekingNow(true);
    // 確保傳送出去的內容 100% 是字串，防止接收端崩潰 (傳送給手錶不受本機顯示開關影響)
    if (onPeekStateChange) onPeekStateChange(String(peekContent));
  };

  const cancelPeek = () => {
    if (pressTimer.current) clearTimeout(pressTimer.current);
    setIsPeekingNow(false);
    if (onPeekStateChange) onPeekStateChange("");
  };

  const handlePointerDown = (e) => {
    if (mode === 'draw') {
      e.currentTarget.setPointerCapture(e.pointerId);
      const rect = cellRef.current.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      setIsDrawing(true);
      updateCell(index, { ...cellData, strokes: [...cellData.strokes, [{ x, y }]] });
    }

    if (isPeekerEnabled && mode !== 'practice') {
      if (pressTimer.current) clearTimeout(pressTimer.current);
      pressTimer.current = setTimeout(() => {
        triggerPeek();
      }, 300); // 0.3 秒觸發
    }
  };

  const handlePointerMove = (e) => {
    if (isDrawing) cancelPeek();
    if (!isDrawing || mode !== 'draw') return;
    const rect = cellRef.current.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const newStrokes = [...cellData.strokes];
    newStrokes[newStrokes.length - 1].push({ x, y });
    updateCell(index, { ...cellData, strokes: newStrokes });
  };

  const handlePointerUp = (e) => {
    if (mode === 'draw') {
      setIsDrawing(false);
      e.currentTarget.releasePointerCapture(e.pointerId);
    }
    cancelPeek();
  };

  return (
    <div
      ref={cellRef}
      className={`relative flex items-center justify-center bg-white select-none overflow-hidden ${containerClass}`}
      // 終極觸控鎖定：防止平板長按跳出放大鏡或複製選單
      style={{ touchAction: 'none', WebkitTouchCallout: 'none', WebkitUserSelect: 'none' }}
      onPointerDown={handlePointerDown}
      onPointerMove={handlePointerMove}
      onPointerUp={handlePointerUp}
      onPointerLeave={cancelPeek}
      onPointerCancel={cancelPeek}
      onContextMenu={(e) => { e.preventDefault(); }} 
    >
      {mode === 'practice' && (
        <div className={`absolute inset-0 flex items-center justify-center transition-all duration-500
            ${isRevealed ? 'opacity-100 scale-100' : 'opacity-0 scale-50'}
            ${isGrey ? 'bg-amber-100 text-amber-700' : 'bg-white text-slate-800'}
        `}>
          <span className={`${textClass} font-bold tracking-widest`}>{calcVal}</span>
        </div>
      )}

      {mode !== 'practice' && (
        <>
          {mode === 'type' && (
            <input
              type="text"
              className={`absolute inset-0 w-full h-full bg-transparent text-center ${textClass} font-bold text-slate-800 outline-none z-10 placeholder-transparent focus:bg-slate-50/50 transition-colors tracking-widest`}
              value={cellData.text}
              onChange={(e) => updateCell(index, { ...cellData, text: e.target.value })}
            />
          )}
          {mode === 'draw' && cellData.text && (
            <div className={`absolute inset-0 flex items-center justify-center ${textClass} font-bold text-slate-800 pointer-events-none tracking-widest`}>
              {cellData.text}
            </div>
          )}
          <svg className="absolute inset-0 w-full h-full pointer-events-none z-0">
            {cellData.strokes.map((stroke, i) => (
              <polyline
                key={i}
                points={stroke.length === 1 ? `${stroke[0].x},${stroke[0].y} ${stroke[0].x + 0.1},${stroke[0].y}` : stroke.map(p => `${p.x},${p.y}`).join(' ')}
                fill="none"
                stroke="#1e293b"
                strokeWidth="5"
                strokeLinecap="round"
                strokeLinejoin="round"
              />
            ))}
          </svg>
        </>
      )}

      {/* 🌟 畫板端的小抄顯示 (受 showLocalHint 開關控制) 🌟 */}
      {isPeekingNow && showLocalHint && (
        <div className="absolute bottom-1 right-1.5 z-30 pointer-events-none animate-in fade-in duration-75">
          <span className="text-[12px] sm:text-[14px] font-bold text-slate-300 leading-none tracking-widest bg-white/80 rounded px-1.5 py-0.5 drop-shadow-sm whitespace-nowrap">
            {peekContent}
          </span>
        </div>
      )}

      {mode === 'practice' && !isRevealed && seqNumber && (
        <span className="absolute text-lg font-medium text-neutral-200 pointer-events-none">
          {seqNumber}
        </span>
      )}
    </div>
  );
};

// --- 手錶端畫面 (接收端) ---
const WatchFace = ({ activePeek, roomCode, isConnected }) => {
  const [time, setTime] = useState(new Date());

  useEffect(() => {
    const timer = setInterval(() => setTime(new Date()), 1000);
    return () => clearInterval(timer);
  }, []);

  const hours = time.getHours().toString().padStart(2, '0');
  const minutes = time.getMinutes().toString().padStart(2, '0');
  
  // 安全取得日期
  let dateStr = "";
  try {
    dateStr = time.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }).toUpperCase();
  } catch (e) {
    dateStr = time.toDateString().toUpperCase();
  }

  // 確保傳入的字串安全
  const safePeek = String(activePeek || '');

  return (
    <div className="min-h-screen bg-black flex flex-col items-center justify-center text-white overflow-hidden select-none relative" style={{ WebkitUserSelect: 'none' }}>
      {safePeek ? (
        <div className="text-5xl sm:text-7xl font-mono font-bold tracking-widest text-slate-200 animate-in zoom-in-95 duration-100 text-center px-4 leading-tight">
          {safePeek.split('  ').map((num, i) => (
             <div key={i} className="my-2 drop-shadow-lg">{num}</div>
          ))}
        </div>
      ) : (
        <div className="flex flex-col items-center opacity-85 animate-in fade-in duration-300">
          <div className="text-7xl sm:text-8xl font-light tracking-wider">
            {hours}<span className="animate-pulse opacity-50">:</span>{minutes}
          </div>
          <div className="text-base sm:text-xl text-neutral-500 mt-2 tracking-widest">
            {dateStr}
          </div>
        </div>
      )}

      {/* 隱蔽連線狀態：放在最底部 */}
      <div className="absolute bottom-2 left-0 right-0 text-center text-[10px] text-[#222] tracking-widest font-mono z-0 pointer-events-none">
        {isConnected ? `R:${roomCode} • LINK` : 'WAITING...'}
      </div>
    </div>
  );
};

// --- 主應用程式 ---
const App = () => {
  const [user, setUser] = useState(null);
  const [appRole, setAppRole] = useState('menu'); 
  const [roomCode, setRoomCode] = useState('');
  const [inputCode, setInputCode] = useState('');

  const [syncedPeek, setSyncedPeek] = useState('');
  const [isDbConnected, setIsDbConnected] = useState(false);

  const [activeTab, setActiveTab] = useState('magicSquare'); 
  const [appMode, setAppMode] = useState('draw'); 
  
  // 🌟 魔術機關狀態 🌟
  const [isPeekerEnabled, setIsPeekerEnabled] = useState(false); // 總開關 (是否允許長按)
  const [showLocalHint, setShowLocalHint] = useState(true);      // 畫板顯示開關 (預設開啟)
  
  const [masterNumber, setMasterNumber] = useState('');

  const [squareCells, setSquareCells] = useState(Array.from({ length: 16 }, () => ({ text: '', strokes: [] })));
  const [brainCells, setBrainCells] = useState(Array.from({ length: 4 }, () => ({ text: '', strokes: [] })));
  
  const [squareStep, setSquareStep] = useState(0);
  const [brainStep, setBrainStep] = useState(0);

  // 1. Firebase 認證
  useEffect(() => {
    if (!auth) return;
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (e) {
        console.error("Auth Error", e);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  // 2. 監聽 Firebase 資料同步 (雙向確認連線)
  useEffect(() => {
    if (!db || !user || !roomCode) return;
    
    const roomRef = doc(db, 'artifacts', String(appId), 'public', 'data', 'rooms', String(roomCode));
    
    const unsubscribe = onSnapshot(roomRef, (snapshot) => {
      if (snapshot.exists()) {
        setSyncedPeek(snapshot.data().activePeek || '');
      }
      setIsDbConnected(true);
    }, (error) => {
      console.error("Sync Error", error);
      setIsDbConnected(false);
    });

    return () => unsubscribe();
  }, [user, roomCode]);

  // 3. 畫板端發送資料
  const handlePeekStateChange = async (peekContent) => {
    if (appRole === 'phone' && user && roomCode && db) {
      const roomRef = doc(db, 'artifacts', String(appId), 'public', 'data', 'rooms', String(roomCode));
      try {
        await setDoc(roomRef, { activePeek: String(peekContent), updatedAt: new Date().toISOString() }, { merge: true });
      } catch (e) {
        console.error("Push Error", e);
      }
    }
  };

  const startPhoneMode = () => {
    const newCode = Math.floor(1000 + Math.random() * 9000).toString();
    setRoomCode(newCode);
    setAppRole('phone');
  };

  const startWatchMode = () => {
    if (inputCode.length === 4) {
      setRoomCode(inputCode);
      setAppRole('watch');
    }
  };

  const handleClearAll = () => {
    setSquareCells(Array.from({ length: 16 }, () => ({ text: '', strokes: [] })));
    setBrainCells(Array.from({ length: 4 }, () => ({ text: '', strokes: [] })));
    setSquareStep(0);
    setBrainStep(0);
    handlePeekStateChange(''); // 清除手錶上的殘留數字
  };

  // --- 魔術計算邏輯 ---
  const extractedTargetX = masterNumber.length >= 2 ? masterNumber.slice(-2) : (masterNumber || '0');
  
  const calculateSquareGrid = (xValue) => {
    const x = parseInt(xValue, 10);
    if (isNaN(x)) return Array(16).fill('');
    const base = x - 20;
    return [
      4, 5, 11, base,
      base + 1, 10, 8, 1,
      6, 3, base - 1, 12,
      9, base + 2, 2, 7
    ];
  };
  const calculatedSquare = calculateSquareGrid(extractedTargetX);
  const greyCellsIndices = [3, 4, 10, 13];
  
  const calculateBrainNumbers = (yValue) => {
    const y = parseInt(yValue, 10);
    if (isNaN(y)) return Array(4).fill('');
    return [String(y - 111111), '18877', '53080', '39154'];
  };
  const calculatedBrain = calculateBrainNumbers(masterNumber);

  // === 畫面渲染：選單 ===
  if (appRole === 'menu') {
    return (
      <div className="min-h-screen bg-neutral-900 flex flex-col items-center justify-center p-6 text-neutral-100 font-sans">
        <div className="max-w-sm w-full space-y-8">
          <div className="text-center space-y-2">
            <Eye className="w-12 h-12 text-amber-500 mx-auto mb-4" />
            <h1 className="text-3xl font-bold tracking-widest text-white">TOP SECRET</h1>
            <p className="text-neutral-400">雙機魔術連線系統</p>
          </div>

          <div className="space-y-4 pt-8">
            <button 
              onClick={startPhoneMode}
              className="w-full flex items-center justify-center space-x-3 bg-neutral-800 hover:bg-neutral-700 text-white p-4 rounded-xl border border-neutral-700 transition-all shadow-lg"
            >
              <Smartphone className="w-6 h-6 text-amber-500" />
              <span className="text-lg font-medium tracking-wider">建立畫板 (發送端)</span>
            </button>

            <div className="relative flex items-center py-4">
              <div className="flex-grow border-t border-neutral-800"></div>
              <span className="flex-shrink-0 mx-4 text-neutral-500 text-sm">接收答案</span>
              <div className="flex-grow border-t border-neutral-800"></div>
            </div>

            <div className="bg-neutral-800 p-4 rounded-xl border border-neutral-700 flex space-x-2 shadow-lg">
              <input 
                type="number"
                placeholder="輸入配對碼"
                className="w-full bg-neutral-900 text-white px-4 py-3 rounded-lg outline-none text-center tracking-widest text-xl"
                value={inputCode}
                onChange={(e) => setInputCode(e.target.value.slice(0, 4))}
              />
              <button 
                onClick={startWatchMode}
                disabled={inputCode.length !== 4}
                className="bg-amber-500 text-neutral-900 px-6 rounded-lg font-bold disabled:opacity-50 transition-opacity flex items-center"
              >
                <Watch className="w-6 h-6" />
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // === 畫面渲染：手錶端 (接收端) ===
  if (appRole === 'watch') {
    return <WatchFace activePeek={syncedPeek} roomCode={roomCode} isConnected={isDbConnected} />;
  }

  // === 畫面渲染：畫板端 (發送端) ===
  return (
    <div className="min-h-screen bg-neutral-900 text-neutral-100 font-sans selection:bg-amber-500/30 pb-10">
      <header className="bg-neutral-950 border-b border-neutral-800 p-4 sticky top-0 z-50">
        <div className="max-w-md mx-auto flex items-center justify-between">
          <div className="flex items-center space-x-2">
            
            {/* 總開關 (眼睛) */}
            <div 
              className="p-2 -ml-2 cursor-pointer select-none"
              onClick={() => setIsPeekerEnabled(!isPeekerEnabled)}
              style={{ WebkitTapHighlightColor: 'transparent' }}
            >
              {isPeekerEnabled ? <Eye className="w-6 h-6 text-neutral-400" /> : <EyeOff className="w-6 h-6 text-neutral-800" />}
            </div>
            
            {/* 🌟 畫板顯示開關 (手機圖示)：只有在總開關開啟時才出現 🌟 */}
            {isPeekerEnabled && (
              <div 
                className="p-1 cursor-pointer select-none animate-in fade-in zoom-in duration-200"
                onClick={() => setShowLocalHint(!showLocalHint)}
                style={{ WebkitTapHighlightColor: 'transparent' }}
              >
                <Smartphone className={`w-5 h-5 transition-colors ${showLocalHint ? 'text-neutral-400' : 'text-neutral-800'}`} />
              </div>
            )}

            {/* 連線狀態顯示 */}
            <div className="flex items-center space-x-1.5 bg-neutral-900 px-2.5 py-1 rounded border border-neutral-800 ml-2">
              {isDbConnected ? (
                <Link className="w-3.5 h-3.5 text-emerald-500" />
              ) : (
                <Link2Off className="w-3.5 h-3.5 text-rose-500 animate-pulse" />
              )}
              <span className="text-xs font-mono text-neutral-400 tracking-wider">ROOM:{roomCode}</span>
            </div>
          </div>

          <div className="flex bg-neutral-800 rounded-lg p-1">
            <button onClick={() => setActiveTab('superBrain')} className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${activeTab === 'superBrain' ? 'bg-amber-500 text-neutral-950' : 'text-neutral-400'}`}>
              大腦
            </button>
            <button onClick={() => setActiveTab('magicSquare')} className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${activeTab === 'magicSquare' ? 'bg-amber-500 text-neutral-950' : 'text-neutral-400'}`}>
              魔方陣
            </button>
          </div>
        </div>
      </header>

      <main className="max-w-md mx-auto p-4 sm:p-6 space-y-6">
        <div className="bg-neutral-800/80 p-4 rounded-2xl border border-neutral-700/50 backdrop-blur-sm space-y-4 shadow-lg">
          <div>
            <label className="block text-sm font-medium text-neutral-400 mb-2">觀眾指定的組合 (6位數)</label>
            <input
              type="number"
              value={masterNumber}
              onChange={(e) => {
                setMasterNumber(e.target.value);
                handleClearAll();
              }}
              className="w-full bg-neutral-900 border border-neutral-700 rounded-xl px-4 py-3 text-2xl font-bold text-center text-emerald-400 focus:outline-none focus:border-emerald-500 transition-colors tracking-widest"
              placeholder=""
            />
          </div>
          <div className="flex justify-between items-center pt-2 border-t border-neutral-700/50">
            <div className="flex bg-neutral-900 rounded-lg p-1 space-x-1">
              <button onClick={() => setAppMode('draw')} className={`flex items-center px-3 py-2 rounded-md text-sm transition-colors ${appMode === 'draw' ? 'bg-neutral-700 text-white' : 'text-neutral-400'}`}>
                <PenTool className="w-4 h-4 mr-1.5" /> 手寫
              </button>
              <button onClick={() => setAppMode('type')} className={`flex items-center px-3 py-2 rounded-md text-sm transition-colors ${appMode === 'type' ? 'bg-neutral-700 text-white' : 'text-neutral-400'}`}>
                <Type className="w-4 h-4 mr-1.5" /> 輸入
              </button>
            </div>
            <button onClick={handleClearAll} className="p-2 text-neutral-400 hover:text-rose-400 transition-colors bg-neutral-900 rounded-lg">
              <Eraser className="w-5 h-5" />
            </button>
          </div>
        </div>

        {activeTab === 'superBrain' && (
          <div className="animate-in fade-in slide-in-from-left-4 duration-500">
            <div className="bg-neutral-300 p-2 rounded-xl shadow-2xl flex flex-col space-y-[2px] border-4 border-neutral-300">
              {brainCells.map((cellData, index) => (
                <DrawCell
                  key={`brain-${index}`}
                  index={index}
                  mode={appMode}
                  cellData={cellData}
                  updateCell={(i, d) => { const n=[...brainCells]; n[i]=d; setBrainCells(n); }}
                  calcVal={calculatedBrain[index]}
                  isRevealed={true}
                  isPeekerEnabled={isPeekerEnabled}
                  showLocalHint={showLocalHint} // 傳入畫板顯示狀態
                  peekContent={calculatedBrain[index]}
                  onPeekStateChange={handlePeekStateChange}
                  containerClass="w-full h-20 sm:h-24 rounded-sm"
                  textClass="text-4xl sm:text-5xl"
                />
              ))}
            </div>
          </div>
        )}

        {activeTab === 'magicSquare' && (
          <div className="animate-in fade-in slide-in-from-right-4 duration-500">
            <div className="relative bg-neutral-300 p-[2px] rounded-xl shadow-2xl border-4 border-neutral-300">
              <div className="grid grid-cols-4 gap-[2px]">
                {squareCells.map((cellData, index) => {
                  const rowIndex = Math.floor(index / 4);
                  const rowAnswers = calculatedSquare.slice(rowIndex * 4, rowIndex * 4 + 4);
                  return (
                    <DrawCell
                      key={`square-${index}`}
                      index={index}
                      mode={appMode}
                      cellData={cellData}
                      updateCell={(i, d) => { const n=[...squareCells]; n[i]=d; setSquareCells(n); }}
                      calcVal={calculatedSquare[index]}
                      isRevealed={true}
                      isGrey={greyCellsIndices.includes(index)}
                      isPeekerEnabled={isPeekerEnabled}
                      showLocalHint={showLocalHint} // 傳入畫板顯示狀態
                      peekContent={rowAnswers.join('  ')}
                      onPeekStateChange={handlePeekStateChange}
                      containerClass="aspect-square rounded-sm"
                      textClass="text-3xl sm:text-4xl"
                    />
                  );
                })}
              </div>
            </div>
          </div>
        )}
      </main>
    </div>
  );
};

export default App;


